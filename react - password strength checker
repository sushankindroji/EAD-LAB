### 🧩 `src/PasswordStrengthChecker.jsx`

```jsx
import React, { useState } from "react";
import "./App.css";

function PasswordStrengthChecker() {
  const [password, setPassword] = useState("");
  const [strength, setStrength] = useState("");

  // Function to check password strength
  const evaluateStrength = (password) => {
    if (!password) return "";
    if (password.length < 6) return "Weak";
    if (/(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[\W_]).{8,}/.test(password))
      return "Strong";
    return "Moderate";
  };

  const handleChange = (e) => {
    const pwd = e.target.value;
    setPassword(pwd);
    setStrength(evaluateStrength(pwd));
  };

  return (
    <div className="container">
      <h2>Password Strength Checker</h2>

      <div className="instructions">
        <p><strong>Password Rules:</strong></p>
        <ul>
          <li><strong>Weak</strong>: less than 6 characters</li>
          <li><strong>Moderate</strong>: simple but more than 6 characters</li>
          <li><strong>Strong</strong>: includes uppercase, lowercase, number, and special character (length ≥ 8)</li>
        </ul>
      </div>

      <input
        type="password"
        value={password}
        onChange={handleChange}
        placeholder="Enter password"
      />

      {password && (
        <p className={`strength ${strength.toLowerCase()}`}>
          Password Strength: {strength}
        </p>
      )}
    </div>
  );
}

export default PasswordStrengthChecker;
```

