## 🧩 1. `src/Parent.jsx`

```jsx
// src/Parent.jsx
import { useState } from "react";
import Child from "./Child";

function Parent() {
  const [message, setMessage] = useState("Hello from Parent Component!");

  const handleChange = () => {
    setMessage("Message updated from Parent!");
  };

  return (
    <div>
      <h1>State and Props Demo</h1>
      <Child text={message} />
      <button onClick={handleChange}>Change Message</button>
    </div>
  );
}

export default Parent;
```

